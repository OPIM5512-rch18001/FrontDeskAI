# Copy to .env (or set these in your host's dashboard). Every value is optional.

# Port the server listens on (hosts like Render set this automatically)
PORT=3000

# The number callers dial to reach FrontDesk AI. Shown on the website.
# Leave blank to show a clearly labeled placeholder.
FRONTDESK_PHONE=

# Optional API key. If set, POST /api/bookings and POST /api/retell/webhook
# require it (header: x-api-key, or Authorization: Bearer <key>, or ?api_key=).
# If blank, those endpoints are open (fine for local development).
API_KEY=

# Set both RETELL_PORT and API_KEY for a local staff demo with separate Retell tool access.
# The website and Retell-only listener bind to localhost in this mode.
# Point an HTTPS tunnel at RETELL_PORT only.
RETELL_PORT=

# Shared demo password. Set this before making the customer site port public.
STAFF_PASSWORD=

# Where the SQLite database file lives. On free hosts the disk may be wiped
# on restart; the app re-seeds sample data automatically when the DB is empty.
DB_PATH=./data/frontdesk.db
